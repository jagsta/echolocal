# MTK connectivity .rc configure

on post-fs-data

# WiFi
    mkdir /data/misc/wifi 0770 wifi wifi
    mkdir /data/misc/wifi/sockets 0770 wifi wifi
    mkdir /data/misc/wpa_supplicant 0770 wifi wifi
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi

# Pre-allocation memory for wifi driver
    insmod /vendor/lib/modules/wlan_mt76x3_sdio_prealloc.ko

# L wlan driver
    insmod /vendor/lib/modules/wlan_mt76x3_sdio.ko


# Bluetooth
    insmod /vendor/lib/modules/btmtksdio.ko

on boot

# Wlan
service wpa_supplicant /vendor/bin/hw/wpa_supplicant \
    -iwlan0 -Dnl80211 -c/data/misc/wifi/wpa_supplicant.conf \
    -I/vendor/etc/wifi/wpa_supplicant_overlay.conf \
    -O/data/misc/wifi/sockets \
    -g@android:wpa_wlan0
    interface android.hardware.wifi.supplicant@1.0::ISupplicant default
    interface android.hardware.wifi.supplicant@1.1::ISupplicant default
    socket wpa_wlan0 dgram 660 wifi wifi
    class main
    oneshot

# Set CPU affinity
service wifi_affinity /system/bin/set_affinity.sh
    class main
    oneshot
    disabled
    user root
    group system readproc

on property:sys.boot_completed=1
    start wifi_affinity

# Accept RA
    write /proc/sys/net/ipv6/conf/default/accept_ra_rt_info_max_plen 64
